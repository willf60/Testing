{
  "type": "module",
  "scripts": {
    "pull": "shopify theme pull",
    "push": "shopify theme push",
    "settings": "shopify theme pull --ignore=\"\" --only=\"config/settings_data.json\" --only=\"templates/*.json\"",
    "deploy": "node ./deploy.js",
    "dev": "shopify theme dev --ignore=\"\"",
    "check-fonts": "uv run --with fonttools --with brotli bin/check-fonts.py"
  },
  "devDependencies": {
    "chalk": "^5.4.1",
    "inquirer": "^12.5.2",
    "ora": "^8.2.0",
    "toml": "^3.0.0"
  }
}
